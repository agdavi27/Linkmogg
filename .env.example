# --- Required ---
DATABASE_URL=                 # Neon pooled connection string (…-pooler…)
DATABASE_URL_UNPOOLED=        # Neon direct connection string, used for migrations
AUTH_SECRET=                  # openssl rand -base64 32
ADMIN_EMAIL=                  # your sign-in email; comma-separate for more than one admin

# --- Recommended ---
NEXT_PUBLIC_APP_URL=          # https://your-domain.com (falls back to the Vercel URL)
NEXT_PUBLIC_BADGE_URL=        # where "Get your own →" points (defaults to your landing page)

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=                   # e.g. Linkmogg <hello@your-domain.com>  (sign-in emails)
OUTREACH_FROM=                # e.g. Drew <drew@mail.your-outreach-domain.com>  (outreach, separate domain)
OUTREACH_REPLY_TO=            # optional
RESEND_WEBHOOK_SECRET=        # from the Resend webhook you create for /api/resend/webhook

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=              # the $10/month recurring price
STRIPE_WEBHOOK_SECRET=        # from the Stripe webhook for /api/stripe/webhook
MONTHLY_PRICE_USD=10          # only used for the MRR number in admin

# --- Uploads + cron ---
BLOB_READ_WRITE_TOKEN=        # added automatically when you connect a Vercel Blob store
CRON_SECRET=                  # any long random string; Vercel Cron sends it automatically

# --- Local dev only ---
# ALLOW_DEV_LOGIN=true        # shows the sign-in link on screen when RESEND_API_KEY is missing (never in production)
